+         */
         set: (value) => {
-            set(value);
-            if (isBrowser) {
-                localStorage.setItem('theme', value);
-                document.documentElement.classList.toggle('dark', value === 'dark');
+            const entry = THEMES.find(t => t.name === value);
+            if (!entry) {
+                console.warn(`Invalid theme: ${value}. Falling back to 'light'.`);
